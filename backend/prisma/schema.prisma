

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Game {
  id Int @id @default(autoincrement())

  boardState Json
  currentPlayer String @default("white")
  gameStatus String @default("waiting")
 
  whitePlayerId String //socketId или временный ID
  blackPlayerId String? //socketId или временный ID

  whiteTimeLeft Int @default(180)
  blackTimeLeft Int @default(180)

  lastDoubleStepPawn Json?
  highlightLastMove Json?

  winner String?
  
  // createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt
}