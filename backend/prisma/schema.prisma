

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlayerColor {
  white
  black
}
enum gameStatus {
  waiting
  playing
  check
  checkmate
  timeout
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  password String
  refreshTokens String[] // Refresh tokens array
  createdAt DateTime @default(now())
}

model Game {
  id Int @id @default(autoincrement())

  fen String
  currentPlayer PlayerColor @default(white)
  gameStatus gameStatus @default(waiting)
 
  whitePlayerId String //socketId or temporary ID
  blackPlayerId String? //socketId or temporary ID

  whiteTimeLeft Int @default(180)
  blackTimeLeft Int @default(180)

  lastDoubleStepPawn Json?
  highlightLastMove Json?

  winner String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whitePlayerId])
  @@index([blackPlayerId])
  @@index([gameStatus])
}